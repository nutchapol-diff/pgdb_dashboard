# Copy to .env locally. Do not commit the copied file.
# SQL Server source (read-only account recommended)
SRC_MSSQL_HOST=10.10.12.97
SRC_MSSQL_PORT=1433
SRC_MSSQL_DATABASE=RIS_CU
SRC_MSSQL_USER=
SRC_MSSQL_PASSWORD=
SRC_MSSQL_DRIVER=ODBC Driver 18 for SQL Server
SRC_MSSQL_ENCRYPT=no

# PostgreSQL/TimescaleDB target used by the prototype
PGHOST=127.0.0.1
PGPORT=6543
PGDATABASE=radops_cu_prototype
PGUSER=postgres
PGPASSWORD=

# Optional loader controls
SOURCE_SCHEMA=dbo
PG_SCHEMA=dw
PAGE_SIZE=5000
